---
// Accordion of questions and answers using native <details>/<summary>
// (keyboard accessible and works without JavaScript).
// Props:
//   items: { q: string; a?: string; prompt?: string }[]   required
//          (an item with `prompt` and no `a` shows a "To fill in" placeholder)
//   class?: string
import Placeholder from './Placeholder.astro';

interface Props {
  items: { q: string; a?: string; prompt?: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<div class:list={['faq', className]}>
  {
    items.map((item) => (
      <details class="faq__item">
        <summary class="faq__q">
          <span class="faq__q-text">{item.q}</span>
          <svg class="faq__chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M3.5 6l4.5 4.5L12.5 6" />
          </svg>
        </summary>
        <div class="faq__a">
          {item.a ? <p>{item.a}</p> : <Placeholder prompt={item.prompt ?? 'Your answer.'} />}
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--rule);
    interpolate-size: allow-keywords; /* lets the height animate where supported */
  }

  .faq__item {
    border-bottom: 1px solid var(--rule);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: 1.15rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--text);
    transition: color var(--dur) var(--ease);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q::marker {
    content: '';
  }

  .faq__q:hover {
    color: var(--accent-ink);
  }

  .faq__q:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .faq__chevron {
    flex: none;
    fill: none;
    stroke: var(--sage-ink);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 220ms var(--ease);
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__a {
    padding-bottom: 1.4rem;
    padding-right: 2.5rem;
    max-width: var(--measure);
    color: var(--muted);
    text-wrap: pretty;
  }

  .faq__item[open] .faq__a {
    animation: faq-fade 220ms var(--ease);
  }

  @keyframes faq-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Smooth open/close where the browser supports animating <details>. */
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 220ms var(--ease), content-visibility 220ms allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__chevron,
    .faq__item::details-content {
      transition: none;
    }
    .faq__item[open] .faq__a {
      animation: none;
    }
  }

  @media (max-width: 30em) {
    .faq__q {
      font-size: 1.25rem;
    }
    .faq__a {
      padding-right: 0;
    }
  }
</style>
