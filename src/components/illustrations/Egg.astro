---
// A speckled egg in pencil line. Works large (spot illustration) or tiny (inline mark, ~12-16px).
// Decorative (aria-hidden).
// Props:
//   tone?: 'cream' | 'brown' | 'blue'   shell wash, default 'brown' (blue = an Araucana egg)
//   size?: number | string              px width or CSS width, default 32
//   speckles?: boolean                  default true (turn off for very small sizes)
//   wash?: boolean                      default true
//   tilt?: number                       rotation in degrees, default 0
//   strokeWidth?: number                default 1.4
//   class?: string
import { sizeAttrs, type Size } from './_util';

interface Props {
  tone?: 'cream' | 'brown' | 'blue';
  size?: Size;
  speckles?: boolean;
  wash?: boolean;
  tilt?: number;
  strokeWidth?: number;
  class?: string;
}

const { tone = 'brown', size, speckles = true, wash = true, tilt = 0, strokeWidth, class: className } = Astro.props;
const attrs = sizeAttrs(size, 40, 50, 32);
const style = [attrs.style, strokeWidth ? `--ill-stroke:${strokeWidth}px` : ''].filter(Boolean).join(';') || undefined;
const washTone = { cream: 'yolk', brown: 'hen', blue: 'sky' }[tone];

// Not quite closed: the line overlaps itself at the top like a quick pencil outline.
const shell = 'M17.6 3.6C27.6 1.8 35.6 18.6 35.8 30.6C36 41 29 47.2 20.2 47.2C11.2 47.2 4.2 41.2 4.2 31.2C4.2 19.4 10.4 4.2 20.6 3.4';
const fill = 'M20 3.4C30 3.4 35.8 19.6 35.8 30.8C35.8 41 29 47.2 20.2 47.2C11.2 47.2 4.2 41.2 4.2 31.2C4.2 19.4 10.4 3.4 20 3.4Z';
const dots = [
  [14, 16, 0.9], [23.5, 12.5, 0.7], [27, 22, 1.1], [12, 27, 0.8], [19.5, 24, 0.6], [30, 33, 0.8],
  [16, 37, 1], [24, 40, 0.7], [9.5, 36, 0.6], [22, 31.5, 0.9],
];
---

<svg
  viewBox="0 0 40 50"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['ill', 'ill-egg', className]}
  width={attrs.width}
  height={attrs.height}
  style={style}
>
  <g transform={tilt ? `rotate(${tilt} 20 26)` : undefined}>
    {wash && <path class:list={['ill-wash', `ill-wash--${washTone}`]} d={fill} />}
    <path d={shell} />
    <path class="ill-ghost" d="M8.4 33.6C9.4 39.4 13.4 43.2 18.6 44" />
    {
      speckles && (
        <g class="ill-speckle" stroke="none">
          {dots.map(([cx, cy, rr]) => <circle cx={cx} cy={cy} r={rr} />)}
        </g>
      )
    }
  </g>
</svg>
