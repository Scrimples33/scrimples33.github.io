---
// A curving fern frond: a single rachis with paired leaflets that shrink towards the tip.
// Decorative (aria-hidden).
// Props:
//   size?: number | string   px width or CSS width, default 48
//   flip?: boolean           curve to the left instead of the right
//   wash?: boolean           soft sage wash on the leaflets, default true
//   strokeWidth?: number     default 1.3
//   class?: string
import { leafPath, quadAt, sizeAttrs, wobble, round, type Size } from './_util';

interface Props {
  size?: Size;
  flip?: boolean;
  wash?: boolean;
  strokeWidth?: number;
  class?: string;
}

const { size, flip = false, wash = true, strokeWidth, class: className } = Astro.props;
const attrs = sizeAttrs(size, 72, 128, 48);
const style = [`--ill-stroke:${strokeWidth ?? 1.3}px`, attrs.style].filter(Boolean).join(';');

const p0 = [14, 124];
const p1 = [22, 52];
const p2 = [60, 8];
const rachis = `M${p0[0]} ${p0[1]}Q${p1[0]} ${p1[1]} ${p2[0]} ${p2[1]}`;

const count = 13;
const pinnae = Array.from({ length: count }, (_, i) => {
  const t = 0.12 + (i / (count - 1)) * 0.82;
  const pt = quadAt(p0, p1, p2, t);
  const L = round(17 * (1 - t * 0.78) + wobble(i, 0.8));
  const W = round(L * 0.26);
  return { ...pt, L, W, i };
});
---

<svg
  viewBox="0 0 72 128"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['ill', 'ill-fern', className]}
  width={attrs.width}
  height={attrs.height}
  style={style}
>
  <g transform={flip ? 'translate(72 0) scale(-1 1)' : undefined}>
    <path d={rachis} />
    {
      pinnae.map((p) => (
        <g transform={`translate(${p.x} ${p.y})`}>
          {[-1, 1].map((side) => (
            <g transform={`rotate(${round(p.angle + side * (58 - p.i * 1.4))})`}>
              {wash && side === 1 && <path class="ill-wash ill-wash--sage" d={leafPath(p.L, p.W, side * 0.8)} />}
              <path d={leafPath(p.L, p.W, side * 0.8)} />
            </g>
          ))}
        </g>
      ))
    }
    <path d="M60 8C61.6 6.4 63.4 6 64.8 7" />
  </g>
</svg>
