---
// A characterful side-view hen in loose pencil line, facing left. Decorative (aria-hidden).
// Props:
//   pose?: 'stand' | 'peck'   default 'stand' ('peck' = head down to the ground)
//   size?: number | string    px width (number) or a CSS width such as '100%' / '8rem'; default 120
//   wash?: boolean            soft russet body wash and red comb, default true
//   ground?: boolean          a few grass strokes and seeds under her feet, default false
//   flip?: boolean            face right instead of left
//   strokeWidth?: number      line weight in screen px, default 1.4
//   class?: string
// Colour: lines use currentColor, so set `color` on the element or a parent (e.g. class="ill-ink").
import { sizeAttrs, type Size } from './_util';

interface Props {
  pose?: 'stand' | 'peck';
  size?: Size;
  wash?: boolean;
  ground?: boolean;
  flip?: boolean;
  strokeWidth?: number;
  class?: string;
}

const { pose = 'stand', size, wash = true, ground = false, flip = false, strokeWidth, class: className } = Astro.props;
const attrs = sizeAttrs(size, 120, 100, 120);
const style = [attrs.style, strokeWidth ? `--ill-stroke:${strokeWidth}px` : ''].filter(Boolean).join(';') || undefined;

// Shared parts: tail, body underside, wing and legs are the same in both poses; the neck and head change.
// Tail: two pointed feather tips, then the full rear curve down to the fluffy underside.
const tail =
  'M91 20.5C93 14.4 96.8 10.6 100.6 9.6C99.6 13.6 100.4 16.8 102.6 18.6C104.6 15.2 107.8 13.2 110.8 13C108.6 17 107.6 21.2 107.8 25.6C108.6 38.4 106.4 50.4 98.6 60';
const tailInner = ['M95 23.6C98.6 32.6 99.4 43 96.4 53', 'M102.6 18.6C104.4 28.6 104.4 41 101.4 50.6'];
const underside = 'M98.6 60C92.4 70.4 80.4 78.4 64.4 80C52.6 81 41.4 78.4 33.8 72.6';
const wing = 'M44.6 51.6C51.8 45.4 67.2 45 76.6 53.6C80.4 57.6 78.2 63.8 71.2 65.2';
const wingFeathers = ['M50.8 58.2C57.4 55.8 64.6 57 70.4 61.2', 'M56.8 63.6C61.4 62.6 65 63.4 67.8 65.4'];
const legs = [
  'M53 80.4C52.6 84.4 52 88.6 51.4 92.2', 'M51.4 92.2L44.6 94.6', 'M51.4 92.2L52.4 96.4', 'M51.4 92.2L57.2 94.2',
  'M63.6 79.6C64.2 83.4 64.6 87.4 64.8 91', 'M64.8 91L58.8 93.8', 'M64.8 91L66.6 95.2', 'M64.8 91L70.6 92.6',
];

const stand = {
  wash: 'M38 33C47 42 60 44 70 41.6C79 39.6 87 30 91 20.5C93 14.4 96.8 10.6 100.6 9.6C99.6 13.6 100.4 16.8 102.6 18.6C104.6 15.2 107.8 13.2 110.8 13C108.6 17 107.6 21.2 107.8 25.6C108.6 38.4 106 51 98.6 60C92 71 80 79 64 80.4C47 82 31 76 25 64C20.6 55 21 46 24.6 40C24 33 27 26 33 24.4C37 25.6 39.4 29 38 33Z',
  back: 'M38.2 33.4C45 40.8 57.6 44.4 68.6 42.2C78.6 40.2 86.6 31 91 20.5',
  ghost: 'M44 38.6C52 42.8 61.4 43.6 69.4 41.6',
  front: 'M33.8 72.6C28.2 68 24.4 61.2 23.4 54C22.6 48.4 23.2 43.8 24.8 40.2',
  head: 'M24.8 40.2C20.6 36.4 19.4 30.4 21.2 26.2C23.4 20.6 30.4 18.6 35 21.4C38.8 23.8 40.2 29 38.2 33.4',
  beak: 'M21 26.8C18.4 27.8 16 29 13.6 30.4C16.2 31 18.6 31.6 21.4 32',
  eye: [27.4, 25.8],
  comb: 'M22.6 21.6C21.2 17.6 23.6 15 26.2 17.6C26 13.8 29.8 12.8 30.8 16.6C31.8 13.8 36 14.4 35 19.4C34 20.6 33.2 21 32.2 20.8',
  wattle: 'M21.6 32.2C20.6 35.6 22.4 38.4 24.4 36.6C25.4 35.4 25 33.6 23.4 32.6',
  hackles: ['M32.8 36.4C34.4 39.6 36.8 41.8 40.2 43', 'M28.6 39.8C30.6 43.6 33.6 46 37.4 47.2'],
};

const peck = {
  wash: 'M21 69C30 57 44 46 62 44C76 42.4 86 31 91 20.5C93 14.4 96.8 10.6 100.6 9.6C99.6 13.6 100.4 16.8 102.6 18.6C104.6 15.2 107.8 13.2 110.8 13C108.6 17 107.6 21.2 107.8 25.6C108.6 38.4 106 51 98.6 60C92 71 80 79 64 80.4C51 81.6 40 80 32 76C28 74.8 24 76.4 20.4 79.6C14 82 10 79 11 74.6C12 70.6 17 68 21 69Z',
  back: 'M21.4 69.4C30 57.4 44.6 46.2 61.8 44.2C76.4 42.4 86 31.8 91 20.5',
  ghost: 'M30 60.4C38 52.6 48.4 46.8 60.4 45',
  front: 'M33.8 72.6C30.8 74.6 27.2 75.6 23.6 77.6',
  head: 'M21.4 69.4C17 67.6 12.4 70 11.2 74.4C10.2 78.4 13.6 81.4 18 80.2C20.2 79.6 22 78.6 23.6 77.6',
  beak: 'M11.8 76.2C9.6 78 8 80.2 6.8 83C9.4 82.6 11.6 81.6 13.6 80.4',
  eye: [16.2, 73.2],
  comb: 'M12.8 71.2C10.4 68.4 12 65.6 14.8 67.4C14.2 63.8 18 63.2 18.8 66.8C20.4 64.4 24 65.8 22 69.8',
  wattle: 'M14.2 80.8C13.6 84 15.8 85.6 17.4 83.6C18.2 82.6 17.8 81.4 16.8 80.6',
  hackles: ['M27.4 64.6C29.4 67.8 31.4 69.8 34.6 71', 'M33.4 58.6C35 62 37.4 64.4 40.6 65.8'],
};

const p = pose === 'peck' ? peck : stand;
const flipT = flip ? 'translate(120 0) scale(-1 1)' : undefined;
---

<svg
  viewBox="0 0 120 100"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['ill', 'ill-hen', className]}
  width={attrs.width}
  height={attrs.height}
  style={style}
>
  <g transform={flipT}>
    {wash && <path class="ill-wash ill-wash--hen" d={p.wash} transform="translate(1.6 1.4)" />}
    {wash && <path class="ill-fill ill-fill--hen" d={p.comb + 'Z'} />}
    {wash && <path class="ill-fill ill-fill--hen" d={p.wattle + 'Z'} />}
    <path d={p.back} />
    <path class="ill-ghost" d={p.ghost} transform="translate(0.6 -1.1)" />
    <path d={tail} />
    {tailInner.map((d) => <path class="ill-soft" d={d} />)}
    <path d={underside} />
    <path d={p.front} />
    <path d={p.head} />
    <path d={p.beak} />
    <path d={p.comb} />
    <path d={p.wattle} />
    <circle class="ill-dot" cx={p.eye[0]} cy={p.eye[1]} r="1.15" />
    {p.hackles.map((d) => <path class="ill-soft" d={d} />)}
    <path d={wing} />
    {wingFeathers.map((d) => <path class="ill-soft" d={d} />)}
    {legs.map((d) => <path d={d} />)}
    {
      ground && (
        <g class="ill-soft">
          <path d="M30 96.6C42 95.8 56 96.4 76 96" />
          <path d="M36 96.2C35.4 93 35.8 90.6 37.2 88.4M38.6 96C39 93.4 40.2 91.6 42 90.4" />
          <path d="M78.4 96C78 92.6 78.8 89.8 80.8 87.6M81.4 96C82 93.8 83.4 92.4 85.4 91.6" />
          <circle class="ill-dot" cx={pose === 'peck' ? 4.6 : 22} cy={pose === 'peck' ? 90.4 : 95.4} r="0.8" />
          <circle class="ill-dot" cx={pose === 'peck' ? 9.4 : 26} cy={pose === 'peck' ? 92 : 94.2} r="0.7" />
        </g>
      )
    }
  </g>
</svg>
