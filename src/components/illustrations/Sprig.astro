---
// A leafy botanical sprig: one gently wandering stem with alternate leaves, each with a midrib.
// Decorative (aria-hidden).
// Props:
//   orientation?: 'up' | 'right' | 'left'   which way the stem grows, default 'up'
//   size?: number | string   px width or CSS width; default 40 ('up') or 80 ('right'/'left')
//   berries?: boolean        add a few rose-hip berries near the tip, default false
//   wash?: boolean           soft sage wash on alternate leaves, default true
//   strokeWidth?: number     default 1.4
//   class?: string
import { leafPath, midribPath, sizeAttrs, type Size } from './_util';

interface Props {
  orientation?: 'up' | 'right' | 'left';
  size?: Size;
  berries?: boolean;
  wash?: boolean;
  strokeWidth?: number;
  class?: string;
}

const { orientation = 'up', size, berries = false, wash = true, strokeWidth, class: className } = Astro.props;
const vertical = orientation === 'up';
const attrs = vertical ? sizeAttrs(size, 64, 128, 40) : sizeAttrs(size, 128, 64, 80);
const style = [attrs.style, strokeWidth ? `--ill-stroke:${strokeWidth}px` : ''].filter(Boolean).join(';') || undefined;

// Drawn upright in a 64 x 128 box, then rotated for the horizontal orientations.
const stem = 'M33 126C31.2 106 34.2 86 32.2 64C30.8 48 31.8 30 36.4 8';
const twig = 'M32.4 70C36.6 66.8 41.2 65.6 45.6 66.2';
// [x, y, angle, length, half-width, bend]
const leaves: [number, number, number, number, number, number][] = [
  [32.6, 108, -152, 25, 7.2, 2.2],
  [33.4, 96, -26, 24, 7, -2.4],
  [32.2, 80, -146, 23, 6.6, 2],
  [45.6, 66.2, -40, 14, 4.6, -1.2],
  [31.6, 56, -150, 19, 5.8, 1.6],
  [32, 44, -34, 18, 5.6, -1.6],
  [32.8, 30, -138, 14, 4.6, 1.2],
  [34.2, 20, -42, 12.5, 4, -1],
  [36.4, 8, -76, 8.5, 3, 0.4],
];
const berrySpots = [
  [41.6, 16.6, 2.6],
  [45.2, 21.8, 2.3],
  [40.4, 23.4, 2],
];

const groupT =
  orientation === 'right' ? 'translate(128 0) rotate(90)' : orientation === 'left' ? 'translate(0 64) rotate(-90)' : undefined;
---

<svg
  viewBox={vertical ? '0 0 64 128' : '0 0 128 64'}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['ill', 'ill-sprig', className]}
  width={attrs.width}
  height={attrs.height}
  style={style}
>
  <g transform={groupT}>
    <path d={stem} />
    <path class="ill-ghost" d="M32.6 100C33.6 90 33.4 80 32.4 70" transform="translate(-0.9 0)" />
    <path d={twig} />
    {
      leaves.map(([x, y, a, L, W, b], i) => (
        <g transform={`translate(${x} ${y}) rotate(${a})`}>
          {wash && i % 2 === 0 && <path class="ill-wash ill-wash--sage" d={leafPath(L, W, b)} transform="translate(0.8 1)" />}
          <path d={leafPath(L, W, b)} />
          {L > 10 && <path class="ill-soft" d={midribPath(L, b)} />}
        </g>
      ))
    }
    {
      berries && (
        <g>
          <path class="ill-soft" d="M36 14C38.4 14.6 40.4 15.6 41.6 16.6M35.4 17C39.4 18.6 43 20 45.2 21.8M35 19C37.2 20.4 39 21.8 40.4 23.4" />
          {berrySpots.map(([cx, cy, rr]) => (
            <circle class="ill-fill ill-fill--hen" cx={cx} cy={cy} r={rr} />
          ))}
        </g>
      )
    }
  </g>
</svg>
