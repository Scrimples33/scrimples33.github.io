---
// A single hen feather: quill, soft vane with a couple of natural splits, a fluffy base.
// Decorative (aria-hidden).
// Props:
//   tone?: 'hen' | 'yolk' | 'sky' | 'sage' | 'blossom'   vane wash, default 'hen'
//   size?: number | string   px width or CSS width, default 24 (the feather is 3x taller than wide)
//   tilt?: number            rotation in degrees, default 0 (positive = clockwise)
//   wash?: boolean           default true
//   strokeWidth?: number     default 1.4
//   class?: string
import { sizeAttrs, type Size, type Tone } from './_util';

interface Props {
  tone?: Tone;
  size?: Size;
  tilt?: number;
  wash?: boolean;
  strokeWidth?: number;
  class?: string;
}

const { tone = 'hen', size, tilt = 0, wash = true, strokeWidth, class: className } = Astro.props;
const attrs = sizeAttrs(size, 36, 108, 24);
const style = [attrs.style, strokeWidth ? `--ill-stroke:${strokeWidth}px` : ''].filter(Boolean).join(';') || undefined;
---

<svg
  viewBox="0 0 36 108"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['ill', 'ill-feather', className]}
  width={attrs.width}
  height={attrs.height}
  style={style}
>
  <g transform={tilt ? `rotate(${tilt} 18 54)` : undefined}>
    {
      wash && (
        <path
          class:list={['ill-wash', `ill-wash--${tone}`]}
          transform="translate(1.2 0.8)"
          d="M20.6 6C27 16 30.4 34 28.4 54C27 68 23 80 18.4 88C13 80 7.6 68 7 52C6.4 34 12 16 20.6 6Z"
        />
      )
    }
    <!-- quill -->
    <path d="M17.6 104.4C17.8 88 18.6 62 19.6 38C20 26 20.4 15 20.6 6" />
    <!-- left vane, broken by one split -->
    <path d="M17.8 86C12 78.4 7.6 67.6 6.8 55.6C6.4 49.6 7 44.4 8.6 39.6" />
    <path d="M10 35.4C12.4 25.6 15.8 13.8 20.6 6" />
    <path class="ill-soft" d="M8.6 39.6L14.4 40.2" />
    <!-- right vane, one split near the base -->
    <path d="M20.6 6C26.4 14.6 29.6 28.6 29 44.4C28.6 54 27.2 62 25.2 67.8" />
    <path d="M24.2 72.6C22.6 77.6 20.8 82.4 18.4 87" />
    <path class="ill-soft" d="M25.2 67.8L20.6 66" />
    <!-- barbs -->
    <g class="ill-soft">
      <path d="M18.8 58C15 55 11.6 51 9.6 46.4" />
      <path d="M19.2 46C16.4 43.6 14 40.4 12.6 36.8" />
      <path d="M19.8 30C18 27.4 16.8 24.6 16.2 21.6" />
      <path d="M19.4 52C22.6 48.6 25.4 44 27 39" />
      <path d="M19.8 38C22.2 35 24.4 31 25.6 26.6" />
      <path d="M18.8 74C21 71.8 22.8 69.4 24 66.8" />
    </g>
    <!-- fluff at the base -->
    <path class="ill-soft" d="M17.8 88C14.4 89.4 11.6 91.8 10.4 95M17.8 89.4C16 92 15 94.6 15 97.6M18 89.2C20.6 90.8 22.4 93.2 23 96.2" />
  </g>
</svg>
