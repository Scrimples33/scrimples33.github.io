---
// A simple cosmos / daisy: notched petals around a stippled centre, optionally on a stem.
// Decorative (aria-hidden).
// Props:
//   tone?: 'blossom' | 'yolk' | 'sky' | 'hen' | 'sage'   petal wash, default 'blossom'
//   stem?: boolean           draw a stem with one leaf, default false
//   petals?: number          5-12, default 8
//   size?: number | string   px width or CSS width, default 40
//   wash?: boolean           default true
//   strokeWidth?: number     default 1.4
//   class?: string
import { leafPath, midribPath, sizeAttrs, wobble, type Size, type Tone } from './_util';

interface Props {
  tone?: Tone;
  stem?: boolean;
  petals?: number;
  size?: Size;
  wash?: boolean;
  strokeWidth?: number;
  class?: string;
}

const { tone = 'blossom', stem = false, petals = 8, size, wash = true, strokeWidth, class: className } = Astro.props;
const vbH = stem ? 128 : 64;
const attrs = sizeAttrs(size, 64, vbH, 40);
const style = [attrs.style, strokeWidth ? `--ill-stroke:${strokeWidth}px` : ''].filter(Boolean).join(';') || undefined;

const n = Math.max(5, Math.min(12, Math.round(petals)));
// One petal along +x, with a soft notch at the tip (cosmos-like).
const petal =
  'M0 0C4.6 -6 13.4 -8 19 -5.6C20.4 -4.8 19.6 -3.2 18.6 -2.4C19.8 -1.8 21.2 -0.4 20.4 1.4C18.4 4.8 12.4 6.6 6 5.2C3 4.4 1 2.4 0 0Z';
const items = Array.from({ length: n }, (_, i) => ({
  angle: (360 / n) * i - 90 + wobble(i, 7),
  scale: 1 + wobble(i + 3, 0.09),
}));
const stipple = [
  [-1.6, -1.8], [1.4, -2.2], [2.6, 0.4], [0.2, 0.8], [-2.4, 1], [-0.6, 2.8], [1.8, 2.4], [-0.4, -3.4], [3.4, -1.6],
];
---

<svg
  viewBox={`0 0 64 ${vbH}`}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['ill', 'ill-flower', className]}
  width={attrs.width}
  height={attrs.height}
  style={style}
>
  {
    stem && (
      <g>
        <path d="M32 38C31 60 34 84 31.4 126" />
        <g transform="translate(32.4 84) rotate(-38)">
          {wash && <path class="ill-wash ill-wash--sage" d={leafPath(22, 6.4, -2)} transform="translate(0.8 1)" />}
          <path d={leafPath(22, 6.4, -2)} />
          <path class="ill-soft" d={midribPath(22, -2)} />
        </g>
      </g>
    )
  }
  <g transform="translate(32 32)">
    {
      items.map((p) => (
        <g transform={`rotate(${p.angle}) translate(4.6 0) scale(${p.scale})`}>
          {wash && <path class:list={['ill-wash', `ill-wash--${tone}`]} d={petal} transform="translate(0.6 0.8)" />}
          <path d={petal} />
          <path class="ill-soft" d="M2.4 0.2C7 0 11.4 -0.6 15 -1.2" />
        </g>
      ))
    }
    <circle class="ill-fill ill-fill--yolk" r="5.2" />
    <circle r="5.2" />
    <g class="ill-speckle" stroke="none">
      {stipple.map(([cx, cy]) => <circle cx={cx} cy={cy} r="0.55" />)}
    </g>
  </g>
</svg>
