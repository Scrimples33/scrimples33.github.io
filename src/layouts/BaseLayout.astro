---
// Site shell.
// Props:
//   title?        page name; shown as "<title> – Anne Williamson" (home page has its own fuller title)
//   description?  search result / link preview text
//   type?         'website' | 'article'
//   image?        picture used when the page is shared (Facebook, WhatsApp...); defaults to Dying Rose
//   imageAlt?     description of that picture
//   imagePosition? where to centre the crop, e.g. 'top' or 'attention' (the busiest part); default centre
//   jsonLd?       structured data for search engines (an object or a list of objects)
// Slots: default (page content inside <main id="main">), "head" (extra <head> tags).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShareImage from '../assets/artworks/dyingrose.jpg';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';

import { withBase } from '../lib/url';
import { site } from '../data/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.tagline,
  type = 'website',
  image = defaultShareImage,
  imageAlt = 'Dying Rose, a colour pencil drawing by Anne Williamson',
  imagePosition,
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : `${site.name} – Portrait and Wildlife Artist, Staffordshire`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Link previews look best at 1200 × 630, so the share picture is cropped to that size.
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', position: imagePosition, format: 'jpg', quality: 80 });
const shareUrl = new URL(share.src, Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F7F3EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1917" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Set the theme before first paint (no flash). Stored choice wins, else the OS setting.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        d.setAttribute('data-theme', theme);
        if (stored === theme) {
          var c = theme === 'dark' ? '#1A1917' : '#F7F3EC';
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.setAttribute('content', c);
          });
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Journal`} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Visitor stats (GoatCounter: no cookies, no personal data). -->
    <script
      is:inline
      data-goatcounter="https://annewilliamson.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
